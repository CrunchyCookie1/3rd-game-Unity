      propertyPath: onConversationEnd.m_PersistentCalls.m_Calls.Array.data[1].m_Mode
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: onConversationEnd.m_PersistentCalls.m_Calls.Array.data[2].m_Mode
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: onConversationEnd.m_PersistentCalls.m_Calls.Array.data[3].m_Mode
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: onConversationEnd.m_PersistentCalls.m_Calls.Array.data[4].m_Mode
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[0].dialogueEntries.Array.data[0].line
      value: Oh, Tod my man how ya doing!
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[1].dialogueEntries.Array.data[0].line
      value: AH! *HUFF* oh hey Melvin it's just you, what's up?
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[2].dialogueEntries.Array.data[0].line
      value: "The sky... Nah but I got the position in the science experiment program.
        Isn\u2019t that exciting. Did you get in as well?"
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[3].dialogueEntries.Array.data[0].line
      value: "Wait. What Melvin what are you tal- *Tod glitches* OHH that one yeah
        man I didn\u2019t get the position sadly. But hey I\u2019m happy for you."
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[4].dialogueEntries.Array.data[0].line
      value: But hey Melvin, I want to let you know. Maybe you should keep this news
        to just the 2 of us. Just in case they try and steal the position.
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[5].dialogueEntries.Array.data[0].line
      value: "Oh, ye that's smart. I\u2019ll keep it to myself don\u2019t worry."
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[6].dialogueEntries.Array.data[0].line
      value: "Anyways Tod have a good one I\u2019ll see you later."
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[7].dialogueEntries.Array.data[0].line
      value: But hey Melvin, I want to let you know. Maybe you should keep this news
        to just the 2 of us. Just in case they try and steal the position.
      objectReference: {fileID: 0}

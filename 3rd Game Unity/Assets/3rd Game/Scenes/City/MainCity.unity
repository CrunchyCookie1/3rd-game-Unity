    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: onConversationEnd.m_PersistentCalls.m_Calls.Array.data[2].m_Mode
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: onConversationEnd.m_PersistentCalls.m_Calls.Array.data[3].m_Mode
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: onConversationEnd.m_PersistentCalls.m_Calls.Array.data[4].m_Mode
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[0].dialogueEntries.Array.data[0].line
      value: "HA! I caught you. Hand over the milk. I don\u2019t want this to get
        messy. Eh I mean nasty... AHHH I mean, fuck it you know what I mean."
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[1].dialogueEntries.Array.data[0].line
      value: "Ehh ok... WELL NO I WON\u2019T HAND IT OVER.\nYOU\u2019LL HAVE TO BEAT
        ME IN THE MAGIC CARD GAME THATS KNOWN AS UNO!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[2].dialogueEntries.Array.data[0].line
      value: "WHAT?! I\u2019m not playing some spanish card game. What even is this
        magical game UNO?"
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[3].dialogueEntries.Array.data[0].line
      value: OHHH it's the most magical game of all time. Each player gets 7 cards
        and the game ends once a player loses all their cards
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[4].dialogueEntries.Array.data[0].line
      value: Sorry were you talking...
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[5].dialogueEntries.Array.data[0].line
      value: "WHAT yo- you weren\u2019t listening... How rude.."
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[6].dialogueEntries.Array.data[0].line
      value: "Listen buddy we\u2019ve been talking for wayyyy too long and that milk
        is mine. I\u2019m sorry"
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[7].dialogueEntries.Array.data[0].line
      value: "WAIT what it is... Oh I\u2019m so sorry about that here take the milk..."
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[8].dialogueEntries.Array.data[0].line
      value: Ohh, wait your actually giving it to me???
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[9].dialogueEntries.Array.data[0].line
      value: "Ye why wouldn\u2019t I. It\u2019s yours"
      objectReference: {fileID: 0}
    - target: {fileID: 7867874687787715051, guid: 71ad012ba448cfc4095ba5a04e9672b6, type: 3}
      propertyPath: dialogueSequences.Array.data[9].dialogueEntries.Array.data[1].line
      value: "WAIT what it is... Oh I\u2019m so sorry about that here take the milk..."
      objectReference: {fileID: 0}

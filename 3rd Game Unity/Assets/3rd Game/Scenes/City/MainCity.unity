  dialogueSequences:
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: What's going on here?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 64fb925fb2933a641bbb72cb76c5a095, type: 3}
  - sequenceName: Norm
    dialogueEntries:
    - speakerName: Norm
      line: Didn't you see those white... eh people just took all our things
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 5f9e4168701fb2d438f5614e362cb943, type: 3}
  - sequenceName: Norm
    dialogueEntries:
    - speakerName: Norm
      line: They took my bike which is super annoying
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 0384aa49c54622340a7467190e3ee7f0, type: 3}
  - sequenceName: Praiselien
    dialogueEntries:
    - speakerName: Praiselien
      line: Yeah, they also took my leg...
      onLineStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 3851382574883777205}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
          - m_Target: {fileID: 3851382574456924604}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
      lineSound: {fileID: 8300000, guid: 193957aab5da87448ad05b989abc5aa3, type: 3}
  - sequenceName: Hubert
    dialogueEntries:
    - speakerName: Hubert
      line: They took my wallet as well, they said it was so the pure white tears
        could wash away our sins or something stupid like that
      onLineStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 3851382574456924604}
            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}

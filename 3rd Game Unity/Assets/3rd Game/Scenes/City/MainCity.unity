            m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
            m_MethodName: SetActive
            m_Mode: 6
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 1
            m_CallState: 2
      lineSound: {fileID: 8300000, guid: 76fbde86e0ff5dd4f8626ac4c2049a80, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Did you go to the police about it?
      onLineStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 3851382574883777205}

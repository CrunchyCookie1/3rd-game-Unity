      propertyPath: dialogueSequences.Array.data[0].dialogueEntries.Array.data[0].line
      value: Here we are one football, now try to be more careful there
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[1].dialogueEntries.Array.data[0].line
      value: Excellent work civilian...
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[2].dialogueEntries.Array.data[0].line
      value: Fine work indeed pal
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[3].dialogueEntries.Array.data[0].line
      value: Huh...
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[4].dialogueEntries.Array.data[0].line
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[5].dialogueEntries.Array.data[0].line
      value: What the fuck is happening!
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[6].dialogueEntries.Array.data[0].line
      value: I am special agent Juan.
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[7].dialogueEntries.Array.data[0].line
      value: "And I am special agent Dan, and we're on a stake out to take out the
        town\u2019s biggest problem"
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[8].dialogueEntries.Array.data[0].line
      value: Oh, so you have heard about them bandits?
      objectReference: {fileID: 0}
    - target: {fileID: 4494070486120546777, guid: e1bc59de2c05988489855cb824ccbad1, type: 3}
      propertyPath: dialogueSequences.Array.data[9].dialogueEntries.Array.data[0].line
      value: Bandits what are you talking about?
      objectReference: {fileID: 0}

  dialogueSequences:
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Hello, whos this?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: bf37cbe8c1ca3ef45a7205f7eff7d7df, type: 3}
  - sequenceName: Detcader
    dialogueEntries:
    - speakerName: ???
      line: "Hello is this Melvin I\u2019m speaking with?"
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 74956116ad6cb014ca4f2f1faded4ca0, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Yes. Who are you?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 4f3e02d7f72fe98409ba14f12e9eb693, type: 3}
  - sequenceName: Detcader
    dialogueEntries:
    - speakerName: Detcader
      line: "Hi, I\u2019m Detcader. I\u2019m calling about the experiment project
        position."
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: e02bd35e7536dae4abc681495b88cf1d, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Oooo did I get the position?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 52139b6c6e9cbad4bbfddeb3aa576f98, type: 3}
  - sequenceName: Detcader
    dialogueEntries:
    - speakerName: Detcader
      line: "Yes, you did. In fact, we\u2019d like you to come down to us tomorrow
        morning. Is that ok?"
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 32d6bc071b81e4348a4b355682cc9c3e, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: "Oh, jiminy cricket! That's perfect. I\u2019ll be there don\u2019t worry"
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 5f4ac85c3c9a7b6439e37758a1f2a684, type: 3}
  - sequenceName: Detcader
    dialogueEntries:
    - speakerName: Detcader
      line: Perfect see you there
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: bf9257fc83caca54fb73914ca2649a67, type: 3}
  npcDisable: {fileID: 0}
  npcEnable: {fileID: 0}

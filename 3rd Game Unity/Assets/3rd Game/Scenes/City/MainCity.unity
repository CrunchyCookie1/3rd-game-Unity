  dialogueText: {fileID: 5212269991587733764}
  nameText: {fileID: 8504536301095160632}
  interactionZone: {fileID: 8439319988782192321}
  cameraPos: {fileID: 4821430632305707989}
  playerVisualDisabled: {fileID: 2044612492}
  displayDialogue: {fileID: 3365523188706456990}
  interactionPanel: {fileID: 8776139561333910789}
  allowExit: 0
  audioSource: {fileID: 1426480762}
  dialogueAdvanceSound: {fileID: 0}
  playSoundOnNewLine: 1
  dialogueSequences:
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: Oh, sir ma restaurant is missing a power.
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 0cd57060678ac0a4d9cc0df54a546d32, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Oh no a power issue. Why does this city constantly have power issues
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: f592de4a5cb824e4fb9c56757840b336, type: 3}
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: I have no idea. But please help me
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 5632d805a1a5ffb4ca90930bc948fa01, type: 3}
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: "See the shop can\u2019t open without power because without power there
        will be no pizza!!"
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 3819519114b75794ea3ef29df3cad9e9, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Ok I think I'm understanding you now. So where do I fix this issue?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: bfda6ab68a875094db52fce724a2b251, type: 3}
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: "The power supply is in the basement of the restaurant, normally I would
        get a repair man to do it, but they don\u2019t seem to be responding"
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 51219c09ee5f2654fa2cae1103e77b78, type: 3}
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: Can you go down into the basement to repair this dreadful issue?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: b9965825a2a034e46b217a0131315e6e, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Eh... I could give it a shot. Wish me luck
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 670729bf6128e0240b6a612ca45c9f64, type: 3}
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: Oh, thank you, THANK YOU!
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: c2ec98f7fd349ff49ba69c4b66ce09af, type: 3}
  npcDisable: {fileID: 0}
  npcEnable: {fileID: 0}

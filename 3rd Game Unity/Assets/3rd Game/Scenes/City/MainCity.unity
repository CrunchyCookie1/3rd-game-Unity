  dialogueText: {fileID: 3239454050754260967}
  nameText: {fileID: 8019962239114307709}
  interactionZone: {fileID: 7322775399368882377}
  cameraPos: {fileID: 4115207375945926285}
  playerVisualDisabled: {fileID: 2044612492}
  displayDialogue: {fileID: 557018974549815790}
  interactionPanel: {fileID: 9196306109175860037}
  allowExit: 0
  audioSource: {fileID: 3111573138967109306}
  dialogueAdvanceSound: {fileID: 0}
  playSoundOnNewLine: 1
  dialogueSequences:
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Hey Tod, my man. How ya been
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 4447efc54ead17646ba1e1815f9456b2, type: 3}
  - sequenceName: Tod
    dialogueEntries:
    - speakerName: Tod
      line: "Well Melvin since it's been oh I don\u2019t know. ONE HOUR probably
        the same as I was ONE HOUR AGO!"
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 6effbdb517ce64947999c4d9e7d251b4, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: HAHA, Tod you're such a hoot. So what ya doing?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: ef157dfd23605b8408233abe6d66409e, type: 3}
  - sequenceName: Tod
    dialogueEntries:
    - speakerName: Tod
      line: Oh ya know, same old same old. I really want to go ho- Ya know what I
        just signed up for this really cool program.
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 57d8cb92c5abb3248bcaba6ff3ba694c, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Whoa what kinda program?
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 184bffe944def67469676734c030ee19, type: 3}
  - sequenceName: Tod
    dialogueEntries:
    - speakerName: Tod
      line: Oh its super cool. You get some easy money for just simply doing experiments.
        You should sign up
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 0a38b271df3d76346923d6a6966f7663, type: 3}
  - sequenceName: Tod
    dialogueEntries:
    - speakerName: Tod
      line: Here take this it's a pamphlet of the program
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: e00a38e4b402b83419fc3cdf4fb40dc8, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: "Oh. Ok well cool I\u2019ll check it out"
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: d4563db703f4c394cba2e07474ddabac, type: 3}

  dialogueSequences:
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Oh man that was super annoying. You could've warned me that you had that
        many security measures!
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: aa91d1624cdb43d4fbc271b530dbc2d6, type: 3}
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: Oh, I'm sorry ye I forgot I had all those puzzles installed well at least
        you got the job done
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 1f5a2d5a8fb7a6c448cae13313f7eacc, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Ye no problem, all in a day's work.
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: cd7086887bfdde6488b841319e9195d4, type: 3}
  - sequenceName: Pizza Man
    dialogueEntries:
    - speakerName: Pizza Man
      line: Well, you're always welcome to get some pizzas from me young man. ON
        THE HOUSE!
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 7fd02924fdea02b4ca29946a99f0b42f, type: 3}
  - sequenceName: Melvin
    dialogueEntries:
    - speakerName: Melvin
      line: Thanks man...
      onLineStart:
        m_PersistentCalls:
          m_Calls: []
      lineSound: {fileID: 8300000, guid: 6daa0969184f8e643ae33dc5598b41f8, type: 3}
